# Copy to .streamlit/secrets.toml (local) — never commit real secrets.

admin_password = "your-secure-password-here"

# PIC-only app (ot_pic_app.py): one password per Jabatan/Unit.
# Keys must match the sheet "Jabatan/Unit" values (case-insensitive).
[ot_pic_unit_passwords]
"ICT" = "change-me-ict"
"Fasiliti" = "change-me-fasiliti"

# Optional: master password to view all PIC units on ot_pic_app.py
# (falls back to admin_password above if not set)
ot_pic_all_password = "change-me-pic-admin"

# Optional — only needed for admin to ADD history entries from the app.
# Progress data is read from the public sheet without this.
[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
